{
  "expo": {
    "name": "capstone_mobile_sp_25_reliefcare",
    "slug": "capstone_mobile_sp_25_reliefcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "reliefcare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reliefcare.mobile"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.reliefcare.mobile"
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
